# ==========================================
# Karaya Realm Environment Template (.env.example)
# Copy this file to .env and adjust variables as needed:
# cp .env.example .env
# ==========================================

# Server Network Settings
PORT=3078
HOST=127.0.0.1
NODE_ENV=development

# Allowed WebSocket Origins (comma-separated)
ORIGINS=http://127.0.0.1:3078,http://localhost:3078,https://games.karaya.site

# Paths & Storage Directories
DATA_DIR=game/data-dev
STATIC_DIR=game
ASSETS_DIR=assets
